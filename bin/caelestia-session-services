#!/bin/sh
# Start per-user services for the Caelestia session.
pgrep -u "$USER" -x pipewire >/dev/null 2>&1 || pipewire >/dev/null 2>&1 &
sleep 1
pgrep -u "$USER" -x pipewire-pulse >/dev/null 2>&1 || pipewire-pulse >/dev/null 2>&1 &
pgrep -u "$USER" -x wireplumber >/dev/null 2>&1 || wireplumber >/dev/null 2>&1 &
